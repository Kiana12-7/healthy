<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/iv_course_cover"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:background="#DDDDDD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_course_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="课程标题"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_course_cover"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_course_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="作者 · 时间"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_course_name"
        app:layout_constraintTop_toBottomOf="@id/tv_course_name" />

</androidx.constraintlayout.widget.ConstraintLayout>