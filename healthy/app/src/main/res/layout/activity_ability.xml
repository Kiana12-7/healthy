<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运动能力"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- 问题1：俯卧撑 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="你可以连续完成多少个俯卧撑？"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgPushup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/pushupNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="从来没试过，或1个也做不了" />
                <RadioButton
                    android:id="@+id/pushupLess10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10个以内" />
                <RadioButton
                    android:id="@+id/pushup10to20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10-20个" />
                <RadioButton
                    android:id="@+id/pushup20to30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20-30个" />
                <RadioButton
                    android:id="@+id/pushupAbove30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30个以上" />
            </RadioGroup>

            <!-- 问题2：深蹲 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="你可以连续完成多少个深蹲？"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgSquat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/squatNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="从来没试过，或1个也做不了" />
                <RadioButton
                    android:id="@+id/squatLess10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10个以内" />
                <RadioButton
                    android:id="@+id/squat10to20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10-20个" />
                <RadioButton
                    android:id="@+id/squat20to30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20-30个" />
                <RadioButton
                    android:id="@+id/squatAbove30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30个以上" />
            </RadioGroup>

            <!-- 问题3：仰卧起坐 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="你可以连续完成多少个仰卧起坐？"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgSitups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/situpsNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="从来没试过，或1个也做不了" />
                <RadioButton
                    android:id="@+id/situpsLess10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10个以内" />
                <RadioButton
                    android:id="@+id/situps10to20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10-20个" />
                <RadioButton
                    android:id="@+id/situps20to30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20-30个" />
                <RadioButton
                    android:id="@+id/situpsAbove30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30个以上" />
            </RadioGroup>

            <!-- 问题4：上五层楼后疲劳程度 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="上五层楼后是否会感到疲累或呼吸急促？"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgStairs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <RadioButton
                    android:id="@+id/stairsVeryTired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="很累，甚至有点喘不过气" />
                <RadioButton
                    android:id="@+id/stairsTired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="比较累，呼吸也比较局促" />
                <RadioButton
                    android:id="@+id/stairsSlightly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="呼吸有点局促，但可以很快恢复" />
                <RadioButton
                    android:id="@+id/stairsAlmostNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="几乎没有感觉" />
                <RadioButton
                    android:id="@+id/stairsVeryEasy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="非常轻松，完全没有感觉" />
            </RadioGroup>

        </LinearLayout>

    </ScrollView>

    <!-- 在生成计划按钮上方添加 -->
    <Button
        android:id="@+id/btnMyInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="我的信息"
        android:textSize="16sp"
        android:backgroundTint="#9E9E9E" />

    <Button
        android:id="@+id/btnGenerate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="生成计划"
        android:textSize="16sp"
        android:backgroundTint="?attr/colorPrimary" />

</LinearLayout>