<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment"
    tools:ignore="MissingDefaultResource">

    <!-- 顶部搜索栏 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/my_fragment"
        android:name="com.example.myapplication.ui.home.topBar.topBarFragment"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout="@layout/fragment_top_bar" />

    <!-- Tab栏-->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/homeTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/home_tab_description"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="#24C688"
        app:tabSelectedTextColor="#333333"
        app:tabTextColor="#999999"
        app:layout_constraintTop_toBottomOf="@id/my_fragment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/homeTabLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/filter_bar_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:paddingVertical="10dp"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewHorizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_filter_goal_home"
            style="@style/GreenFilterButtonStyle"
            android:text="@string/filter_goal" />

        <TextView
            android:id="@+id/btn_filter_part_home"
            style="@style/GreenFilterButtonStyle"
            android:text="@string/filter_part" />

        <TextView
            android:id="@+id/btn_filter_difficulty_home"
            style="@style/GreenFilterButtonStyle"
            android:text="@string/filter_difficulty" />

        <TextView
            android:id="@+id/btn_filter_crowd_home"
            style="@style/GreenFilterButtonStyle"
            android:text="@string/filter_crowd" />
    </LinearLayout>


    <View
        android:id="@+id/divider_filter"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8F5E9"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filter_bar_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homeViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:layout="com.example.myapplication.fragment.PlanItemFragment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeTabLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>