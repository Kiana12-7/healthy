<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运动偏好"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- 问题1：运动类型 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="你希望在基础训练外，增加哪些运动类型？"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgSportType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbYoga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="瑜伽" />
                <RadioButton
                    android:id="@+id/rbRunning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="跑步" />
                <RadioButton
                    android:id="@+id/rbStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="力量训练" />
                <RadioButton
                    android:id="@+id/rbSwimming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="游泳" />
                <RadioButton
                    android:id="@+id/rbCycling"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="骑行" />
                <RadioButton
                    android:id="@+id/rbNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="以上都不需要" />
            </RadioGroup>

            <!-- 问题2：运动时长 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="你希望每天运动多长时间？"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rb20min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20分钟左右" />
                <RadioButton
                    android:id="@+id/rb30min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30分钟左右" />
                <RadioButton
                    android:id="@+id/rb45min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45分钟左右" />
                <RadioButton
                    android:id="@+id/rb60min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60分钟左右" />
            </RadioGroup>

            <!-- 问题3：计划要求 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="对计划是否有以下要求？"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgRequirement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbNoNoise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="零噪音" />
                <RadioButton
                    android:id="@+id/rbNoJump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="无跳跃" />
                <RadioButton
                    android:id="@+id/rbSmallSpace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小场地" />
                <RadioButton
                    android:id="@+id/rbNoRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="没有以上要求" />
            </RadioGroup>

            <!-- 问题4：允许器械 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="是否允许计划使用以下运动器械？"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgEquipment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <RadioButton
                    android:id="@+id/rbNoEquipment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="无器械" />
                <RadioButton
                    android:id="@+id/rbDumbbell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="哑铃" />
                <RadioButton
                    android:id="@+id/rbResistanceBand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹力带" />
                <RadioButton
                    android:id="@+id/rbYogaMat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="瑜伽垫" />
            </RadioGroup>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="下一步"
        android:textSize="16sp"
        android:backgroundTint="?attr/colorPrimary" />

</LinearLayout>