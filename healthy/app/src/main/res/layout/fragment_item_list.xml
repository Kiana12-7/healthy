<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 可折叠+吸顶容器：实现Banner滑走、筛选栏固定 -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="0dp">

        <!-- 可折叠区域：定制计划Banner，下滑时完全滑出屏幕 -->
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="#FFFFFF">

            <!-- 定制计划Banner，完全保留原有属性、可点击交互 -->
            <ImageView
                android:id="@+id/iv_banner_plan"
                android:layout_width="match_parent"
                android:layout_height="195dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ai_plan"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"/>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- 筛选栏：下滑后牢牢固定在屏幕顶部 -->
        <LinearLayout
            android:id="@+id/filter_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:paddingVertical="6dp"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <TextView
                android:id="@+id/btn_filter_goal"
                style="@style/GreenFilterButtonStyle"
                android:text="@string/filter_goal"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/btn_filter_part"
                style="@style/GreenFilterButtonStyle"
                android:text="@string/filter_part"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/btn_filter_difficulty"
                style="@style/GreenFilterButtonStyle"
                android:text="@string/filter_difficulty"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/btn_filter_crowd"
                style="@style/GreenFilterButtonStyle"
                android:text="@string/filter_crowd"
                android:textColor="#000000"/>
        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8F5E9"
            app:layout_scrollFlags="scroll|enterAlways|snap"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 滚动容器 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 计划列表RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_plan_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="ifContentScrolls"
                android:nestedScrollingEnabled="false"/>

            <!-- 底部提示文案 -->
            <TextView
                android:id="@+id/tv_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:text="到底啦，去看看定制其他吧~"
                android:textColor="#999999"
                android:textSize="12sp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>