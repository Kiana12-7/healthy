<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 顶部筛选按钮样式 -->
    <style name="GreenFilterButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textSize">14sp</item>
        <!-- 未选中：绿色文字 -->
        <item name="android:textColor">#4CAF50</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableEnd">@android:drawable/arrow_down_float</item>
        <!-- 选中/未选中背景 -->
        <item name="android:background">@drawable/selector_top_filter_button</item>
    </style>
</resources>